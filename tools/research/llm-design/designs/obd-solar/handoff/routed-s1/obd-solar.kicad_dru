# functional spacing /USB/BB_BOOT2 to OBD_RAW, PV_RAW: worst 42.4 V, IPC-2221B B2
(rule "IR:functional./USB/BB_BOOT2.0.6mm"
  (condition "(A.NetName == '/USB/BB_BOOT2' && (B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/USB/BB_BOOT2' && (A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /USB/BB_FF to PV_RAW: worst 38 V, IPC-2221B B2
(rule "IR:functional./USB/BB_FF.0.6mm"
  (condition "(A.NetName == '/USB/BB_FF' && (B.NetName == 'PV_RAW')) || (B.NetName == '/USB/BB_FF' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /USB/BB_SW1 to OBD_RAW, PV_RAW: worst 49.3 V, IPC-2221B B2
(rule "IR:functional./USB/BB_SW1.0.6mm"
  (condition "(A.NetName == '/USB/BB_SW1' && (B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/USB/BB_SW1' && (A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /USB/BB_SW2 to PV_RAW: worst 37.4 V, IPC-2221B B2
(rule "IR:functional./USB/BB_SW2.0.6mm"
  (condition "(A.NetName == '/USB/BB_SW2' && (B.NetName == 'PV_RAW')) || (B.NetName == '/USB/BB_SW2' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /USB/BB_VCC to PV_RAW: worst 30.5 V, IPC-2221B B2
(rule "IR:functional./USB/BB_VCC.0.6mm"
  (condition "(A.NetName == '/USB/BB_VCC' && (B.NetName == 'PV_RAW')) || (B.NetName == '/USB/BB_VCC' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /USB/DIS_D to PV_RAW: worst 38 V, IPC-2221B B2
(rule "IR:functional./USB/DIS_D.0.6mm"
  (condition "(A.NetName == '/USB/DIS_D' && (B.NetName == 'PV_RAW')) || (B.NetName == '/USB/DIS_D' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing CC1 to PV_RAW: worst 30.5 V, IPC-2221B B2
(rule "IR:functional.CC1.0.6mm"
  (condition "(A.NetName == 'CC1' && (B.NetName == 'PV_RAW')) || (B.NetName == 'CC1' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing CC2 to PV_RAW: worst 30.5 V, IPC-2221B B2
(rule "IR:functional.CC2.0.6mm"
  (condition "(A.NetName == 'CC2' && (B.NetName == 'PV_RAW')) || (B.NetName == 'CC2' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing CHG_OUT to PV_RAW: worst 41 V, IPC-2221B B2
(rule "IR:functional.CHG_OUT.0.6mm"
  (condition "(A.NetName == 'CHG_OUT' && (B.NetName == 'PV_RAW')) || (B.NetName == 'CHG_OUT' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing OBD_RAW to PV_IN, PV_RAW, VBAT: worst 52 V, IPC-2221B B2
(rule "IR:functional.OBD_RAW.0.6mm"
  (condition "(A.NetName == 'OBD_RAW' && (B.NetName == 'PV_IN' || B.NetName == 'PV_RAW' || B.NetName == 'VBAT')) || (B.NetName == 'OBD_RAW' && (A.NetName == 'PV_IN' || A.NetName == 'PV_RAW' || A.NetName == 'VBAT'))")
  (constraint clearance (min 0.6mm)))

# functional spacing PV_IN to PV_RAW: worst 50 V, IPC-2221B B2
(rule "IR:functional.PV_IN.0.6mm"
  (condition "(A.NetName == 'PV_IN' && (B.NetName == 'PV_RAW')) || (B.NetName == 'PV_IN' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing PV_RAW to VBAT, VBUS: worst 49 V, IPC-2221B B2
(rule "IR:functional.PV_RAW.0.6mm"
  (condition "(A.NetName == 'PV_RAW' && (B.NetName == 'VBAT' || B.NetName == 'VBUS')) || (B.NetName == 'PV_RAW' && (A.NetName == 'VBAT' || A.NetName == 'VBUS'))")
  (constraint clearance (min 0.6mm)))

# pads of one part that bridges spaced domains: J101, F101, J201, Q201, R201, R202, U201, C204, Q202, Q203, R209, R210
# (its package sets that spacing; package creepage is checked against the barrier)
(rule "IR:bridging_parts.1"
  (condition "(A.memberOfFootprint('J101') && B.memberOfFootprint('J101')) || (A.memberOfFootprint('F101') && B.memberOfFootprint('F101')) || (A.memberOfFootprint('J201') && B.memberOfFootprint('J201')) || (A.memberOfFootprint('Q201') && B.memberOfFootprint('Q201')) || (A.memberOfFootprint('R201') && B.memberOfFootprint('R201')) || (A.memberOfFootprint('R202') && B.memberOfFootprint('R202')) || (A.memberOfFootprint('U201') && B.memberOfFootprint('U201')) || (A.memberOfFootprint('C204') && B.memberOfFootprint('C204')) || (A.memberOfFootprint('Q202') && B.memberOfFootprint('Q202')) || (A.memberOfFootprint('Q203') && B.memberOfFootprint('Q203')) || (A.memberOfFootprint('R209') && B.memberOfFootprint('R209')) || (A.memberOfFootprint('R210') && B.memberOfFootprint('R210'))")
  (constraint clearance (min 0mm))
  (constraint creepage (min 0mm)))
