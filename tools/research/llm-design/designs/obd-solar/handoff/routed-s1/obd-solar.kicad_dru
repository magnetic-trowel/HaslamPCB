(rule "IR:functional./USB/BB_BOOT1.0.6mm"
  (condition "(A.NetName == '/USB/BB_BOOT1' && (B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/USB/BB_BOOT1' && (A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
