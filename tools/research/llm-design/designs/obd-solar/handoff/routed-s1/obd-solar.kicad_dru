(version 1)

# fab profile jlc-2layer-1oz: https://jlcpcb.com/capabilities/pcb-capabilities (read 2026-11-28)
(rule "FAB:pth_annular_width"
  (condition "A.Type == 'Pad' && A.isPlated()")
  (constraint annular_width (min 0.18mm)))
(rule "FAB:pad_hole_to_hole"
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))
(rule "FAB:pth_hole_clearance"
  (condition "A.Type == 'Pad' && A.isPlated()")
  (constraint hole_clearance (min 0.28mm)))


# functional spacing /BLK/CMP_OUT to PV_RAW: worst 31 V, IPC-2221B B2
(rule "IR:functional./BLK/CMP_OUT.0.6mm"
  (condition "(A.NetName == '/BLK/CMP_OUT' && (B.NetName == 'PV_RAW')) || (B.NetName == '/BLK/CMP_OUT' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /BLK/CMP_VCC to PV_RAW: worst 31 V, IPC-2221B B2
(rule "IR:functional./BLK/CMP_VCC.0.6mm"
  (condition "(A.NetName == '/BLK/CMP_VCC' && (B.NetName == 'PV_RAW')) || (B.NetName == '/BLK/CMP_VCC' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /BLK/QB_G to /BLK/QB_PD, /CHG/CHRG_N, /CHG/DONE_N, /CHG/DRV, /CHG/LEDG_A, /CHG/LEDR_A, /CHG/PV_G, /CHG/SW_CHG, /CHG/VG_CHG, /CTL/LDO_IN, /USB/BB_BOOT1, /USB/BB_BOOT2, /USB/BB_SW1, OBD_RAW, PV_IN, PV_RAW: worst 49 V, IPC-2221B B2
(rule "IR:functional./BLK/QB_G.0.6mm"
  (condition "(A.NetName == '/BLK/QB_G' && (B.NetName == '/BLK/QB_PD' || B.NetName == '/CHG/CHRG_N' || B.NetName == '/CHG/DONE_N' || B.NetName == '/CHG/DRV' || B.NetName == '/CHG/LEDG_A' || B.NetName == '/CHG/LEDR_A' || B.NetName == '/CHG/PV_G' || B.NetName == '/CHG/SW_CHG' || B.NetName == '/CHG/VG_CHG' || B.NetName == '/CTL/LDO_IN' || B.NetName == '/USB/BB_BOOT1' || B.NetName == '/USB/BB_BOOT2' || B.NetName == '/USB/BB_SW1' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_IN' || B.NetName == 'PV_RAW')) || (B.NetName == '/BLK/QB_G' && (A.NetName == '/BLK/QB_PD' || A.NetName == '/CHG/CHRG_N' || A.NetName == '/CHG/DONE_N' || A.NetName == '/CHG/DRV' || A.NetName == '/CHG/LEDG_A' || A.NetName == '/CHG/LEDR_A' || A.NetName == '/CHG/PV_G' || A.NetName == '/CHG/SW_CHG' || A.NetName == '/CHG/VG_CHG' || A.NetName == '/CTL/LDO_IN' || A.NetName == '/USB/BB_BOOT1' || A.NetName == '/USB/BB_BOOT2' || A.NetName == '/USB/BB_SW1' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_IN' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /BLK/QB_PD to /CHG/DRV, /CHG/PV_G, /CHG/VG_CHG, OBD_RAW, PV_RAW: worst 49 V, IPC-2221B B2
(rule "IR:functional./BLK/QB_PD.0.6mm"
  (condition "(A.NetName == '/BLK/QB_PD' && (B.NetName == '/CHG/DRV' || B.NetName == '/CHG/PV_G' || B.NetName == '/CHG/VG_CHG' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/BLK/QB_PD' && (A.NetName == '/CHG/DRV' || A.NetName == '/CHG/PV_G' || A.NetName == '/CHG/VG_CHG' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/CHG_CS to PV_RAW: worst 41 V, IPC-2221B B2
(rule "IR:functional./CHG/CHG_CS.0.6mm"
  (condition "(A.NetName == '/CHG/CHG_CS' && (B.NetName == 'PV_RAW')) || (B.NetName == '/CHG/CHG_CS' && (A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/CHRG_N to /CHG/DRV, /CHG/PV_G, /CHG/VG_CHG, OBD_RAW, PV_RAW: worst 50 V, IPC-2221B B2
(rule "IR:functional./CHG/CHRG_N.0.6mm"
  (condition "(A.NetName == '/CHG/CHRG_N' && (B.NetName == '/CHG/DRV' || B.NetName == '/CHG/PV_G' || B.NetName == '/CHG/VG_CHG' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/CHG/CHRG_N' && (A.NetName == '/CHG/DRV' || A.NetName == '/CHG/PV_G' || A.NetName == '/CHG/VG_CHG' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/DONE_N to /CHG/DRV, /CHG/PV_G, /CHG/VG_CHG, OBD_RAW, PV_RAW: worst 50 V, IPC-2221B B2
(rule "IR:functional./CHG/DONE_N.0.6mm"
  (condition "(A.NetName == '/CHG/DONE_N' && (B.NetName == '/CHG/DRV' || B.NetName == '/CHG/PV_G' || B.NetName == '/CHG/VG_CHG' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/CHG/DONE_N' && (A.NetName == '/CHG/DRV' || A.NetName == '/CHG/PV_G' || A.NetName == '/CHG/VG_CHG' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/DRV to /CHG/LEDG_A, /CHG/LEDR_A, /CHG/SW_CHG, /CTL/LDO_IN, /USB/BB_BOOT1, /USB/BB_SW1, OBD_RAW, PV_RAW, VBAT: worst 50 V, IPC-2221B B2
(rule "IR:functional./CHG/DRV.0.6mm"
  (condition "(A.NetName == '/CHG/DRV' && (B.NetName == '/CHG/LEDG_A' || B.NetName == '/CHG/LEDR_A' || B.NetName == '/CHG/SW_CHG' || B.NetName == '/CTL/LDO_IN' || B.NetName == '/USB/BB_BOOT1' || B.NetName == '/USB/BB_SW1' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW' || B.NetName == 'VBAT')) || (B.NetName == '/CHG/DRV' && (A.NetName == '/CHG/LEDG_A' || A.NetName == '/CHG/LEDR_A' || A.NetName == '/CHG/SW_CHG' || A.NetName == '/CTL/LDO_IN' || A.NetName == '/USB/BB_BOOT1' || A.NetName == '/USB/BB_SW1' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW' || A.NetName == 'VBAT'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/LEDG_A to /CHG/PV_G, /CHG/VG_CHG, OBD_RAW, PV_RAW: worst 50 V, IPC-2221B B2
(rule "IR:functional./CHG/LEDG_A.0.6mm"
  (condition "(A.NetName == '/CHG/LEDG_A' && (B.NetName == '/CHG/PV_G' || B.NetName == '/CHG/VG_CHG' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/CHG/LEDG_A' && (A.NetName == '/CHG/PV_G' || A.NetName == '/CHG/VG_CHG' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/LEDR_A to /CHG/PV_G, /CHG/VG_CHG, OBD_RAW, PV_RAW: worst 50 V, IPC-2221B B2
(rule "IR:functional./CHG/LEDR_A.0.6mm"
  (condition "(A.NetName == '/CHG/LEDR_A' && (B.NetName == '/CHG/PV_G' || B.NetName == '/CHG/VG_CHG' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/CHG/LEDR_A' && (A.NetName == '/CHG/PV_G' || A.NetName == '/CHG/VG_CHG' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/PV_G to /CHG/SW_CHG, /CTL/LDO_IN, /USB/BB_BOOT1, /USB/BB_SW1, OBD_RAW, PV_RAW, VBAT: worst 50 V, IPC-2221B B2
(rule "IR:functional./CHG/PV_G.0.6mm"
  (condition "(A.NetName == '/CHG/PV_G' && (B.NetName == '/CHG/SW_CHG' || B.NetName == '/CTL/LDO_IN' || B.NetName == '/USB/BB_BOOT1' || B.NetName == '/USB/BB_SW1' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW' || B.NetName == 'VBAT')) || (B.NetName == '/CHG/PV_G' && (A.NetName == '/CHG/SW_CHG' || A.NetName == '/CTL/LDO_IN' || A.NetName == '/USB/BB_BOOT1' || A.NetName == '/USB/BB_SW1' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW' || A.NetName == 'VBAT'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/SW_CHG to /CHG/VG_CHG, OBD_RAW, PV_RAW: worst 50.5 V, IPC-2221B B2
(rule "IR:functional./CHG/SW_CHG.0.6mm"
  (condition "(A.NetName == '/CHG/SW_CHG' && (B.NetName == '/CHG/VG_CHG' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/CHG/SW_CHG' && (A.NetName == '/CHG/VG_CHG' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CHG/VG_CHG to /CTL/LDO_IN, /USB/BB_BOOT1, /USB/BB_SW1, OBD_RAW, PV_RAW, VBAT: worst 50 V, IPC-2221B B2
(rule "IR:functional./CHG/VG_CHG.0.6mm"
  (condition "(A.NetName == '/CHG/VG_CHG' && (B.NetName == '/CTL/LDO_IN' || B.NetName == '/USB/BB_BOOT1' || B.NetName == '/USB/BB_SW1' || B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW' || B.NetName == 'VBAT')) || (B.NetName == '/CHG/VG_CHG' && (A.NetName == '/CTL/LDO_IN' || A.NetName == '/USB/BB_BOOT1' || A.NetName == '/USB/BB_SW1' || A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW' || A.NetName == 'VBAT'))")
  (constraint clearance (min 0.6mm)))

# functional spacing /CTL/LDO_IN to OBD_RAW, PV_RAW: worst 49 V, IPC-2221B B2
(rule "IR:functional./CTL/LDO_IN.0.6mm"
  (condition "(A.NetName == '/CTL/LDO_IN' && (B.NetName == 'OBD_RAW' || B.NetName == 'PV_RAW')) || (B.NetName == '/CTL/LDO_IN' && (A.NetName == 'OBD_RAW' || A.NetName == 'PV_RAW'))")
  (constraint clearance (min 0.6mm)))

