# KiCad's Python (pcbnew) as one executable path, for HASLAM_KICAD_PYTHON: run.py and
# physics.py call it as [HASLAM_KICAD_PYTHON, script, ...], and KiCad runs in Apptainer here.
# Paths it reads must be under APPTAINER_BIND (or the home directory).
[ -n "$HASLAM_KICAD_WRAP" ] || . "$HOME/.cache/haslambench/env.sh"
exec $HASLAM_KICAD_WRAP python3 "$@"
